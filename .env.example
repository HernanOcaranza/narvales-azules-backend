# ============================================
# CONFIGURACIÓN DEL ENTORNO
# ============================================
# Entorno de ejecución: development, production, test
NODE_ENV=development

# Puerto en el que correrá el servidor
PORT=3000

# ============================================
# CONFIGURACIÓN DE BASE DE DATOS
# ============================================
# Nombre de la base de datos MySQL
DB_NAME=narvales_azules

# Usuario de la base de datos
DB_USER=root

# Contraseña de la base de datos
DB_PASSWORD=

# Host de la base de datos
DB_HOST=localhost

# Puerto de la base de datos MySQL
DB_PORT=3306

# ============================================
# CONFIGURACIÓN JWT (JSON Web Token)
# ============================================
# Secret key para firmar los tokens JWT
# IMPORTANTE: Cambiar en producción por una clave segura y aleatoria
JWT_SECRET=your-secret-key-change-in-production

# Tiempo de expiración del token JWT
# Formatos: 1h, 24h, 7d, etc.
JWT_EXPIRES_IN=24h

# ============================================
# CONFIGURACIÓN CORS
# ============================================
# Origen permitido para CORS
# Para desarrollo: * (permite todos)
# Para producción: URL específica del frontend (ej: http://localhost:3000)
CORS_ORIGIN=*
